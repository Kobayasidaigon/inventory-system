# データベース設定（SQLite または Azure SQL）
USE_AZURE_SQL=false

# マルチテナントモードを有効にする (true/false)
MULTI_TENANT=false

# データベースディレクトリ (マルチテナントモード時、Fly.ioでは/data)
DB_DIR=/data

# Azure SQL Database設定（Azure環境でのみ使用）
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USER=your-username
AZURE_SQL_PASSWORD=your-password

# サーバー設定
PORT=3000
SESSION_SECRET=inventory-secret-key-2024
NODE_ENV=production

# 通知の大元の切り替え
#
# 未設定なら通知は一切送りません（自動発注のお知らせも、シフト未確認の督促も）。
# 送るように戻すときだけ true を設定します。止めるからには理由があるので、
# 設定を消し忘れただけで鳴り出さないよう、既定は「送らない」にしています。
#
#   flyctl secrets set NOTIFICATIONS_ENABLED=true
#
NOTIFICATIONS_ENABLED=

# LINE Messaging API設定
#
# 【重要】このファイルは公開リポジトリに入ります。実際の値は書かないでください。
# 実際の値は .env（gitignore 済み）か、本番なら flyctl secrets set で渡します。
#
# 2026-02-06 までの版には実トークンがそのまま書かれていました。
# git の履歴には残るため、消しただけでは無効になりません。
# LINE Developers コンソールでチャネルアクセストークンを再発行し、
# チャネルシークレットも作り直してください（手順は LINE_SETUP.md）。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# バックアップ設定
BACKUP_INTERVAL_HOURS=24

# API のレート制限（1分あたりのリクエスト数。未設定なら100）
API_RATE_LIMIT_MAX=100

# シフト未確認の見張り（off で停止。間隔は分単位、未設定なら1分）
# NOTIFICATIONS_ENABLED が未設定なら、ここが on でも見張りは動きません。
SHIFT_MONITOR=on
SHIFT_CHECK_INTERVAL_MINUTES=1

# 区切りの時刻から何分後に通知するか（未設定なら0＝区切りの時刻ちょうど）
SHIFT_GRACE_MINUTES=0

# ジョブカンからの勤務予定取り込み
#
# スクレイパー (GitHub Actions) が POST /api/staff/import-schedules を叩くときの
# 合言葉。未設定だと取り込みは 503 で拒否される（設定漏れのまま誰でも書き込める
# 状態になるより、動かない方が安全なため）。
# openssl rand -base64 32 などで作る。
IMPORT_SECRET=

# 【重要】運用ルール
# ペーパー類（ティッシュ、トイレットペーパー等）を一つでも出したら、必ず在庫システムに登録してください。
